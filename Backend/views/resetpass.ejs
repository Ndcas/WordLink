<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quên mật khẩu</title>
    <link rel="stylesheet" href="/assets/css/bootstrap.min.css">
</head>

<body class="position-relative vw-100 vh-100">
    <form action="/admin/resetPass" method="post" class="container v-75 w-75 position-absolute start-50 top-50 translate-middle">
        <h1 class="text-center mb-5">Đặt Lại Mật Khẩu</h1>
        <div class="row mb-3 justify-content-center">
            <label for="email" class="col-2 col-form-label">Email:</label>
            <div class="col-10">
                <input type="email" name="email" class="form-control" required />
            </div>
        </div>
        <div class="row mb-3 justify-content-center">
            <label for="otp" class="col-2 col-form-label">OTP:</label>
            <div class="col-9">
                <input type="text" name="otp" class="form-control" required />
            </div>
            <button id="otpButton" class="btn btn-success col-1" type="button">Gửi mã</button>
        </div>
        <% if (status != 0) { %>
            <div class="text-center mb-3 text-danger"><%= message %></div>
        <% } %>
        <div class="d-flex justify-content-center">
            <button class="btn btn-primary me-5">Đặt lại mật khẩu</button>
            <a href="/admin" class="btn btn-warning">Đăng nhập</a>
        </div>
    </form>
    <script src="/assets/js/bootstrap.bundle.min.js"></script>
    <script>
        let ready = true;
        let lastRequest = 0;
        let otpButton = document.getElementById('otpButton');
        otpButton.addEventListener('click', async function (event) {
            if (!ready) {
                return;
            }
            let email = document.querySelector('input[name="email"]').value;
            let response = await fetch('/admin/sendOTP', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({email: email})
            });
            let data = await response.json();
            if (response.ok) {
                otpButton.disabled = true;
                lastRequest = Date.now();
                ready = false;
                let counter = setInterval(() => {
                    let current = Date.now();
                    let remainingTime = Math.floor((15000 - current + lastRequest) / 1000);
                    if (remainingTime <= 0) {
                        otpButton.disabled = false;
                        ready = true;
                        otpButton.innerText = 'Gửi mã';
                        clearInterval(counter);
                    } else {
                        otpButton.innerText = remainingTime;
                    }
                }, 1000);
            } else {
                alert(data.message);
            }
        });
    </script>
</body>

</html>
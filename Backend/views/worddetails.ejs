<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Thông tin từ ngữ</title>
    <link rel="stylesheet" href="/assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="/assets/css/datatables.min.css">
    <style>
        .pop {
            height: 100px;
            width: 100px;
            background-color: red;
            margin: 5px auto;
            border-radius: 50%;
            text-align: center;
            line-height: 100px;
            font-size: 25px;
            color: white;
            font-weight: bold;
        }
    </style>
</head>

<body>
    <div class="container py-5">
        <a class="btn btn-primary mb-3" href="/admin/toWord">Trở lại</a>
        <h1 class="text-center mb-5">Thông tin từ ngữ</h1>
        <div class="card">
            <form class="container card-body" action="/admin/editWord" method="post">
                <div class="row mb-3 justify-content-center">
                    <label for="wordV" class="col-2 col-form-label">Từ:</label>
                    <input type="hidden" name="wordV" value="<%= word.WordV %>" />
                    <b class="col-8"><%= word.WordV %></b>
                </div>
                <div class="row mb-3 justify-content-center">
                    <label for="popularity" class="col-2 col-form-label">Độ phổ biến:</label>
                    <div class="col-8 d-flex flex-column">
                        <input type="number" name="popularity" class="form-control" value="<%= word.Popularity %>" min="1" max="9" step="0.1" required />
                    </div>
                </div>
                <% if (status != 0) { %>
                    <div class="mb-3 text-center text-danger"><%= message %></div>
                <% } %>
                <div class="d-flex justify-content-center">
                    <button class="btn btn-primary me-5" type="submit">Lưu thay đổi</button>
                    <button class="btn btn-danger" type="button">Xóa</button>
                </div>
            </form>
        </div>
    </div>
    <script src="/assets/js/bootstrap.bundle.min.js"></script>
    <script src="/assets/js/datatables.min.js"></script>
    <script>
        $(document).ready(function () {
        });
    </script>
</body>

</html>